{% if (!ctx._fluent_login_shown) { %}
</div>
{% if (!ctx.authsession) { %}
<footer>
  <div class="mobile-hide">
    <a class="luci-link" href="https://github.com/openwrt/luci">Powered by {{ version.luciname }} ({{ version.luciversion }})</a> /
                    {{ version.distversion }}
    <ul class="breadcrumb pull-right" id="modemenu" style="display:none"></ul>
  </div>
</footer>
{% } %}
</div>
</div>
<script>
  var luciLocation = {{ sprintf('%J', ctx.path || []) }};
</script>
<script type="text/javascript">L.require('menu-fluent')</script>
</body>
</html>
{% } %}
