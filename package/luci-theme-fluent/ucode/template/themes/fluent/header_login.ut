{#
  Fluent Theme for LuCI - Login Page Header
  Licensed to the public under the Apache License 2.0
#}

{%
  import { access, stat } from 'fs';
  import { cursor } from 'uci';
  import { srand } from 'math';

  // System info
  let boardinfo = ubus.call('system', 'board');
  let hostname = boardinfo && boardinfo.hostname ? boardinfo.hostname : '?';

  let cfg = cursor();
  let defaults = {};
  include('themes/fluent/defaults', { defaults });

  http.prepare_content('text/html; charset=UTF-8');

  srand(+substr(reverse(time() + ""), 0, 8));

  let mode = defaults.mode;
  let primary = defaults.primary;
  let dark_primary = defaults.dark_primary;
  let page_bg = defaults.page_bg;
  let card_bg = defaults.card_bg;
  let dark_page_bg = defaults.dark_page_bg;
  let dark_card_bg = defaults.dark_card_bg;
  let border_radius = defaults.border_radius;
  let control_height = defaults.control_height;
  let prefers_reduced_motion = defaults.prefers_reduced_motion;
  let blur_radius = defaults.blur;
  let blur_radius_dark = defaults.blur_dark;
  let blur_opacity = defaults.transparency;
  let blur_opacity_dark = defaults.transparency_dark;
  let bar_color = primary;
  let has_gz_css = access('/www/luci-static/fluent/css/fluent.css.gz');
  let has_raw_css = access('/www/luci-static/fluent/css/fluent.css');
  let css_stat = stat('/www/luci-static/fluent/css/fluent.css.gz') || stat('/www/luci-static/fluent/css/fluent.css');
  let asset_version = css_stat ? (css_stat.mtime + '-' + css_stat.size) : '@VERSION@';
  let direction = {};
  include('themes/fluent/direction', { cfg, defaults, direction });

  if (access('/etc/config/fluent')) {
    primary = cfg.get_first('fluent', 'global', 'primary') || primary;
    dark_primary = cfg.get_first('fluent', 'global', 'dark_primary') || dark_primary;
    page_bg = cfg.get_first('fluent', 'global', 'page_bg') || page_bg;
    card_bg = cfg.get_first('fluent', 'global', 'card_bg') || card_bg;
    dark_page_bg = cfg.get_first('fluent', 'global', 'dark_page_bg') || dark_page_bg;
    dark_card_bg = cfg.get_first('fluent', 'global', 'dark_card_bg') || dark_card_bg;
    border_radius = cfg.get_first('fluent', 'global', 'border_radius') || border_radius;
    control_height = cfg.get_first('fluent', 'global', 'control_height') || control_height;
    prefers_reduced_motion = cfg.get_first('fluent', 'global', 'prefers_reduced_motion') || prefers_reduced_motion;
    mode = cfg.get_first('fluent', 'global', 'mode') || mode;
    blur_radius = cfg.get_first('fluent', 'global', 'blur') || blur_radius;
    blur_radius_dark = cfg.get_first('fluent', 'global', 'blur_dark') || blur_radius_dark;
    blur_opacity = cfg.get_first('fluent', 'global', 'transparency') || blur_opacity;
    blur_opacity_dark = cfg.get_first('fluent', 'global', 'transparency_dark') || blur_opacity_dark;
    bar_color = (mode === 'dark') ? dark_primary : primary;
  }

  let primary_is_custom = lc(primary) != lc(defaults.primary);
  let dark_primary_is_custom = lc(dark_primary) != lc(defaults.dark_primary);
%}
<!DOCTYPE html>
<html lang="{{ dispatcher.lang }}" dir="{{ direction.resolved }}">

<head>
	<meta charset="utf-8">
	<title>{{ hostname }} - LuCI</title>
  <!-- SEO and Description -->
  <meta name="robots" content="noindex, nofollow">

  <!-- Security -->
  <meta http-equiv="X-Content-Type-Options" content="nosniff">
  <meta http-equiv="Referrer-Policy" content="strict-origin-when-cross-origin">

	<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
	<meta name="format-detection" content="telephone=no, email=no" />
	<meta name="apple-mobile-web-app-capable" content="yes">
	<meta name="mobile-web-app-capable" content="yes">
	<meta name="x5-fullscreen" content="true">
	<meta name="full-screen" content="yes">
	<meta name="x5-page-mode" content="app">
	<meta name="browsermode" content="application">
	<meta name="msapplication-tap-highlight" content="no">
	<meta name="msapplication-TileColor" content="{{ bar_color }}">
	<meta name="application-name" content="{{ hostname }} - LuCI">
	<meta name="apple-mobile-web-app-title" content="{{ hostname }} - LuCI">
	<link rel="apple-touch-icon" href="{{ media }}/icon/icon-192.png">
	<link rel="icon" type="image/png" sizes="192x192" href="{{ media }}/icon/icon-192.png">
	<link rel="icon" type="image/png" sizes="32x32" href="{{ media }}/icon/favicon-32.png">
	<link rel="icon" type="image/svg+xml" href="{{ media }}/img/fluent.svg">
	<link rel="manifest" href="{{ media }}/icon/manifest.json" crossorigin="use-credentials">
	<meta name="msapplication-TileImage" content="{{ media }}/icon/icon-192.png">

  {% if (mode === 'auto') { %}
	<meta name="theme-color" content="{{ bar_color }}">
	<script type="text/javascript">
		(function() {
			var isDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
			document.documentElement.setAttribute('data-theme', isDark ? 'dark' : 'light');
			document.querySelector('meta[name="theme-color"]')?.setAttribute('content', isDark ? '#080B12' : '{{ bar_color }}');
		})();
	</script>
	{% } else if (mode === 'dark') { %}
	<meta name="theme-color" content="#080B12">
	<script type="text/javascript">document.documentElement.setAttribute('data-theme', 'dark');</script>
	{% } else if (mode === 'light') { %}
	<meta name="theme-color" content="{{ bar_color }}">
	<script type="text/javascript">document.documentElement.setAttribute('data-theme', 'light');</script>
	{% } %}

	{% if (has_gz_css && !has_raw_css) { %}
	<style id="fluent-compressed-css"></style>
	<style id="fluent-css-guard">html[data-fluent-css-pending="1"] body { opacity: 0; }</style>
	<script>
		(function () {
			var style = document.getElementById('fluent-compressed-css');
			var guard = document.getElementById('fluent-css-guard');
			var cacheKey = 'fluent-css:{{ asset_version }}';
			if (!style) return;
			try {
				var cached = sessionStorage.getItem(cacheKey);
				if (cached) {
					style.textContent = cached;
					if (guard) guard.remove();
					return;
				}
			} catch (_) {}

			function fallbackToLink() {
				style.remove();
				if (guard) guard.remove();
				document.documentElement.removeAttribute('data-fluent-css-pending');
				var link = document.createElement('link');
				link.rel = 'stylesheet';
				link.href = '{{ media }}/css/fluent.css?v={{ asset_version }}';
				document.head.appendChild(link);
			}

			if (typeof DecompressionStream === 'undefined') {
				console.warn('luci-theme-fluent-lite requires DecompressionStream (Chrome 80+, Firefox 113+, Safari 16.4+).');
				fallbackToLink();
				return;
			}

			document.documentElement.setAttribute('data-fluent-css-pending', '1');
			var guardTimer = setTimeout(function () {
				document.documentElement.removeAttribute('data-fluent-css-pending');
				if (guard) guard.remove();
			}, 800);

			fetch('{{ media }}/css/fluent.css.gz?v={{ asset_version }}').then(async function (response) {
				if (!response.ok) throw new Error('Unable to load Fluent CSS');
				var buffer = await response.arrayBuffer();
				var bytes = new Uint8Array(buffer);
				if (bytes.length >= 2 && bytes[0] === 0x1f && bytes[1] === 0x8b) {
					var stream = new Blob([buffer]).stream().pipeThrough(new DecompressionStream('gzip'));
					return new Response(stream).text();
				}
				return new TextDecoder().decode(buffer);
			}).then(function (css) {
				clearTimeout(guardTimer);
				style.textContent = css;
				document.documentElement.removeAttribute('data-fluent-css-pending');
				if (guard) guard.remove();
				try {
					for (var i = sessionStorage.length - 1; i >= 0; i--) {
						var k = sessionStorage.key(i);
						if (k && k.indexOf('fluent-css:') === 0 && k !== cacheKey) sessionStorage.removeItem(k);
					}
					sessionStorage.setItem(cacheKey, css);
				} catch (_) {}
			}).catch(function () {
				clearTimeout(guardTimer);
				fallbackToLink();
			});
		})();
	</script>
	{% } else { %}
	<link rel="stylesheet" href="{{ media }}/css/fluent.css?v={{ asset_version }}">
	{% } %}

	<style title="text/css">
		{# Default light values - must come FIRST so dark overrides can take precedence #}
		:root {
			--fluent-primary: {{ primary }};
			--fluent-bg-page: {{ page_bg }};
			--fluent-bg: {{ card_bg }};
			--fluent-bg-card: {{ card_bg }};
			--fluent-radius-sm: {{ border_radius / 2 }}px;
			--fluent-radius-md: {{ border_radius }}px;
			--fluent-control-height: {{ control_height }}px;
			--fluent-blur-radius: {{ blur_radius }}px;
			--fluent-blur-opacity: {{ blur_opacity }};
			--fluent-blur-radius-dark: {{ blur_radius_dark }}px;
			--fluent-blur-opacity-dark: {{ blur_opacity_dark }};
			{% if (primary_is_custom) { %}
			--fluent-field-focus-ring: color-mix(in srgb, {{ primary }} 12%, #ffffff);
			--fluent-btn-primary-bg: color-mix(in srgb, {{ primary }} 88%, #000000);
			--fluent-btn-primary-bg-hover: color-mix(in srgb, {{ primary }} 76%, #000000);
			--fluent-btn-primary-bg-active: color-mix(in srgb, {{ primary }} 64%, #000000);
			{% } %}
		}

		@media not print {
		:root[data-theme="dark"] {
			--fluent-primary: {{ dark_primary }};
			--fluent-bg-page: {{ dark_page_bg }};
			--fluent-bg: {{ dark_card_bg }};
			--fluent-bg-card: {{ dark_card_bg }};
			{% if (dark_primary_is_custom) { %}
			--fluent-field-focus-ring: color-mix(in srgb, {{ dark_primary }} 10%, transparent);
			--fluent-btn-primary-bg: color-mix(in srgb, {{ dark_primary }} 88%, #000000);
			--fluent-btn-primary-bg-hover: color-mix(in srgb, {{ dark_primary }} 78%, #000000);
			--fluent-btn-primary-bg-active: color-mix(in srgb, {{ dark_primary }} 68%, #000000);
			{% } %}
		}
		}

		{% if (primary_is_custom || dark_primary_is_custom) { %}
		@supports (color: oklch(from red l c h)) {
			{% if (primary_is_custom) { %}
			:root {
				--fluent-btn-primary-bg: oklch(from {{ primary }} min(l, 0.50) c h);
				--fluent-btn-primary-bg-hover: oklch(from {{ primary }} min(l, 0.44) c h);
				--fluent-btn-primary-bg-active: oklch(from {{ primary }} min(l, 0.38) c h);
			}
			{% } %}
			{% if (dark_primary_is_custom) { %}
			@media not print {
			:root[data-theme="dark"] {
				--fluent-btn-primary-bg: oklch(from {{ dark_primary }} min(l, 0.50) c h);
				--fluent-btn-primary-bg-hover: oklch(from {{ dark_primary }} min(l, 0.44) c h);
				--fluent-btn-primary-bg-active: oklch(from {{ dark_primary }} min(l, 0.38) c h);
			}
			}
			{% } %}
		}
		{% } %}
	</style>

	<link rel="shortcut icon" type="image/ico" href="{{ media }}/favicon.ico">
	<script src="{{ resource }}/luci.js?v={{ version.luciversion }}"></script>
	<script src="{{ resource }}/cbi.js?v={{ version.luciversion }}"></script>
</head>
<body class="lang_{{ dispatcher.lang }} login-page" data-theme-mode="{{ mode }}" data-fluent-dir="{{ direction.resolved }}" data-prefers-reduced-motion="{{ prefers_reduced_motion }}">
