#!/bin/sh
uci batch <<EOF
set luci.themes.Fluent=/luci-static/fluent
commit luci
EOF

if ! uci -q get fluent.@global[0] >/dev/null 2>&1; then
	uci set fluent.global=global
	uci commit fluent
fi

# ---------------------------------------------------------------------------
# Design-token migration — Canonical v3.2
#
# /etc/config/fluent is declared as a conffile, so anything the theme settings
# page ever wrote survives a package upgrade and keeps overriding the shipped
# defaults. A router upgraded from a pre-3.2 build therefore still renders the
# old dark surfaces (#1b1b1b / #2d2d2d / #1f1f1f), the old #0078d4 accent and
# the old 4px / 32px / 48px geometry, even though the new defaults are correct.
#
# Only values that are *byte-for-byte the previous default* are rewritten — a
# colour the user actually picked is never touched. A revision stamp keeps this
# to a single pass, so a later downgrade of a token by the user sticks.
# ---------------------------------------------------------------------------
TOKEN_REV=4

migrate_token() { # <option> <previous default> <new default>
	cur="$(uci -q get "fluent.@global[0].$1")"
	[ -n "$cur" ] || return 0
	[ "$(printf '%s' "$cur" | tr 'A-Z' 'a-z')" = "$2" ] || return 0
	uci set "fluent.@global[0].$1=$3"
}

if [ "$(uci -q get fluent.@global[0].token_rev)" != "$TOKEN_REV" ]; then
	# Brand
	migrate_token primary               '#0078d4' '#024AD8'
	migrate_token dark_primary          '#4da6ff' '#9058FC'
	# Surfaces
	migrate_token page_bg               '#fafafa' '#F2FBFF'
	migrate_token card_bg               '#ffffff' '#FFFFFF'
	migrate_token sidebar_bg            '#f3f3f3' '#FFFFFF'
	migrate_token dark_page_bg          '#1b1b1b' '#080B12'
	migrate_token dark_card_bg          '#2d2d2d' '#101622'
	migrate_token dark_sidebar_bg       '#1f1f1f' '#0B0F18'
	# On-surface text
	migrate_token progressbar_font      '#2e2b60' '#1A1A1A'
	migrate_token dark_progressbar_font '#d6d9e5' '#EEF1FF'
	# Geometry
	migrate_token border_radius         '4'  '8'
	migrate_token header_height         '48' '58'
	# rev 3 moved controls to 36px; rev 4 settles them at 32px, so both the
	# original 32 and the interim 36 land on the current default.
	migrate_token control_height        '36' '32'

	uci set fluent.@global[0].token_rev="$TOKEN_REV"
	uci commit fluent
fi

mkdir -p /www/luci-static/fluent/background
chmod 0755 /www/luci-static/fluent/background
exit 0
