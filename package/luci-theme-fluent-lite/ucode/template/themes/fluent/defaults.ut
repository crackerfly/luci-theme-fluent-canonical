{%
  defaults.mode = "auto";
  defaults.primary = "#024AD8";
  defaults.dark_primary = "#9058FC";
  defaults.progressbar_font = "#1A1A1A";
  defaults.dark_progressbar_font = "#EEF1FF";
  defaults.page_bg = "#F2FBFF";
  defaults.card_bg = "#FFFFFF";
  defaults.sidebar_bg = "#FFFFFF";
  defaults.dark_page_bg = "#080B12";
  defaults.dark_card_bg = "#101622";
  defaults.dark_sidebar_bg = "#0B0F18";
  defaults.font_weight = "normal";
  defaults.font_size = "14";
  defaults.border_radius = "8";
  defaults.control_height = "36";
  defaults.sidebar_width = "260";
  defaults.header_height = "58";
  defaults.login_bg = "microsoft";
  defaults.blur = "40";
