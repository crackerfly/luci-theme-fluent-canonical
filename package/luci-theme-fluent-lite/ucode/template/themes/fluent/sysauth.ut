{% include('themes/fluent/out_header_login'); %}
{#
  Fluent Theme for LuCI - Login Page
  Licensed to the public under the Apache License 2.0
#}

{%
  import { access, glob, popen } from 'fs';
  import { cursor } from 'uci';

  // System info
  let boardinfo = ubus.call('system', 'board');
  let hostname = boardinfo && boardinfo.hostname ? boardinfo.hostname : '?';

  let cfg = cursor();
  let defaults = {};
  include('themes/fluent/defaults', { defaults });
  let mode = defaults.mode;
  let primary = defaults.primary;
  let dark_primary = defaults.dark_primary;
  let blur_radius = defaults.blur;
  let blur_radius_dark = defaults.blur_dark;
  let blur_opacity = defaults.transparency;
  let blur_opacity_dark = defaults.transparency_dark;
  let bar_color = primary;

  if (access('/etc/config/fluent')) {
    mode = cfg.get_first('fluent', 'global', 'mode') || mode;
    primary = cfg.get_first('fluent', 'global', 'primary') || primary;
    dark_primary = cfg.get_first('fluent', 'global', 'dark_primary') || dark_primary;
    blur_radius = cfg.get_first('fluent', 'global', 'blur') || blur_radius;
    blur_radius_dark = cfg.get_first('fluent', 'global', 'blur_dark') || blur_radius_dark;
    blur_opacity = cfg.get_first('fluent', 'global', 'transparency') || blur_opacity;
    blur_opacity_dark = cfg.get_first('fluent', 'global', 'transparency_dark') || blur_opacity_dark;

    bar_color = mode === 'dark' ? dark_primary : primary;
  }

  // Background image handling
  let imageTypes = {
    jpg: true, jpeg: true, png: true, gif: true, webp: true
  };
  let videoTypes = {
    mp4: true, webm: true
  };

  function fetchMedia(path, themeDir) {
    let backgroundTable = [];
    let backgroundCount = 0;

    try {
      let files = glob(path);
      for (let f in files) {
        let m = match(f, regexp('.+\\.([A-Za-z0-9]+)$'));
        let ext = m ? lc(m[1]) : null;

        if (ext in imageTypes || ext in videoTypes) {
          let parts = split(f, '/');
          let filename = parts[length(parts) - 1];
          push(backgroundTable, {
            type: ext,
            is_video: ext in videoTypes,
            url: themeDir + filename
          });
          backgroundCount++;
        }
      }
    } catch (e) {}

    return [backgroundTable, backgroundCount];
  }

  function selectBackground(themeDir) {
    let bgUrl = '';
    let backgroundType = 'None';
    let mimeType = '';
    let login_bg = defaults.login_bg;

    if (access('/etc/config/fluent')) {
      login_bg = cfg.get_first('fluent', 'global', 'login_bg') || login_bg;
    }

    if (login_bg === 'microsoft' || login_bg === 'medusae') {
      return ['', 'MedusaeDynamic', ''];
    }

    if (login_bg === 'bing') {
      try {
        let proc = popen('/usr/libexec/fluent/online_wallpaper');
        let picurl = proc ? trim(proc.read('all')) : '';
        if (proc)
          proc.close();
        if (picurl) {
          return [picurl, 'Image', ''];
        }
      } catch (e) {}
    }

    if (login_bg !== 'custom') {
      return ['', 'None', ''];
    }

    // Custom mode: rotate uploaded media from the background directory
    let mediaFiles = fetchMedia('/www' + themeDir + '*', themeDir);
    let backgroundTable = mediaFiles[0];
    let backgroundCount = mediaFiles[1];
    if (backgroundCount > 0) {
      let currentBg = backgroundTable[time() % backgroundCount];
      bgUrl = currentBg.url;
      if (currentBg.is_video) {
        backgroundType = 'Video';
        mimeType = 'video/' + currentBg.type;
      }
    }

    return [bgUrl, backgroundType, mimeType];
  }

  let themeDir = media + '/background/';
  let selectedBg = selectBackground(themeDir);
  let bgUrl = selectedBg[0];
  let backgroundType = selectedBg[1];
  let mimeType = selectedBg[2];
%}

<!-- Login Page Start -->
<div class="login-page" id="auth-view">
  {% if (backgroundType === 'Video') { %}
  <!-- Video Player Start -->
  <div class="video">
    <video autoplay loop muted playsinline id="video">
      <source src="{{ bgUrl }}" type="{{ mimeType }}">
    </video>
  </div>
  <button type="button" class="volume-control mute" aria-label="{{ _('Toggle background audio') }}" aria-pressed="false"></button>
  <script>
    document.querySelector(".volume-control").addEventListener("click", function(){
      var video = document.getElementById("video");
      if(this.classList.contains("mute")){
        this.classList.remove("mute");
        this.setAttribute("aria-pressed", "true");
        video.muted = false;
      } else {
        this.classList.add("mute");
        this.setAttribute("aria-pressed", "false");
        video.muted = true;
      }
    });
  </script>
  <!-- Video Player End -->
  {% } else if (backgroundType === 'MedusaeDynamic') { %}
  <!-- BreathDearMedusae Dynamic Canvas Background -->
  <div id="login-medusae" class="main-bg login-medusae" aria-hidden="true"><canvas id="login-medusae-canvas" class="login-medusae-canvas" data-ui-canvas="decoration" aria-hidden="true" hidden></canvas></div>
  <script type="text/javascript">//<![CDATA[
/* Integrated from Touch-Moon/Lab__BreathDearMedusae.
 * Upstream commit: c8f0648eaf1d21ad607a3b202b159a8a60a59c1e
 * The animation math and palette are preserved. Only settings and login-page
 * lifecycle/viewport integration differ; upstream credits are retained in vendor/.
 */
(function () {
  'use strict';
  const view = document.getElementById('auth-view');
  const host = document.getElementById('login-medusae');
  const canvas = document.getElementById('login-medusae-canvas');
  if (!view || !host || !canvas) return;
  let ctx;
  try { ctx = canvas.getContext('2d'); } catch (_) { return; }
  if (!ctx) return;

  // BEGIN UPSTREAM SETTINGS, CONSTANTS AND HELPERS
    // ── Colors (Google brand palette) ─────────────────────────────────────────
    let COLOR_BASE     = [0,   0,   255]
    const COLOR_ONE    = [66,  133, 245]   // Google blue
    const COLOR_TWO    = [235, 66,  54]    // Google red
    const COLOR_THREE  = [250, 186, 3]     // Google yellow

    // ── Live controls (adjustable from the control panel) ──────────────────────
    const P = {
      breathSpeed:    1.28,    // breath frequency
      haloRadius:     2.40,    // jellyfish size
      activeSize:     0.024,  // rim glow size
      cursorFollow:   0.72,    // how strongly particles follow the cursor
      cursorStrength: 3.0,      // cursor reach / sway
      density:        1.20,    // particle density (re-inits the grid)
    }

    // ── Grid ──────────────────────────────────────────────────────────────────
    const GRID_X_BASE = 70, GRID_Y_BASE = 38
    let GRID_X = GRID_X_BASE, GRID_Y = GRID_Y_BASE
    const GRID_WIDTH = 40, GRID_HEIGHT = 22
    const JITTER = 0.25

    // ── Halo ──────────────────────────────────────────────────────────────────
    const HALO_RADIUS_BASE   = 2.4
    const HALO_RADIUS_AMP    = 0.5
    const HALO_SHAPE_AMP     = 0.75
    const HALO_RIM_WIDTH     = 1.8
    const HALO_SCALE_X       = 1.3
    const HALO_SCALE_Y       = 1.0

    // ── Outer oscillation ─────────────────────────────────────────────────────
    const OUTER_OSC_FREQ            = 2.6
    const OUTER_OSC_AMP             = 0.76
    const OUTER_OSC_JITTER_STRENGTH = 0.025
    const OUTER_OSC_JITTER_SPEED    = 0.3
    const OUTER_START = 0.4, OUTER_END = 2.2

    // ── Particles ─────────────────────────────────────────────────────────────
    const PARTICLE_BASE_SIZE   = 0.008
    const PARTICLE_ACTIVE_SIZE = 0.022
    const BLOB_SCALE_X = 1.0, BLOB_SCALE_Y = 0.6
    const ROTATION_SPEED  = 0.1
    const ROTATION_JITTER = 0.1
    const OSC_FACTOR = 1.0
    const CURSOR_FOLLOW_STRENGTH = 0.8

    // ── Cursor ────────────────────────────────────────────────────────────────
    const CURSOR_RADIUS   = 0.065
    const CURSOR_STRENGTH = 3
    const CURSOR_DRAG     = 0.015

    // ── Helpers ───────────────────────────────────────────────────────────────
    function hash(x, y) {
      return ((Math.sin(x * 12.9898 + y * 78.233) * 43758.5453) % 1 + 1) % 1
    }

    function noise2d(px, py) {
      const ix = Math.floor(px), iy = Math.floor(py)
      const fx = px - ix,        fy = py - iy
      const sx = fx*fx*(3-2*fx), sy = fy*fy*(3-2*fy)
      const a = hash(ix,iy), b = hash(ix+1,iy)
      const c = hash(ix,iy+1), d = hash(ix+1,iy+1)
      return a + (b-a)*sx + (c-a)*sy + (a-b-c+d)*sx*sy
    }

    function smoothstep(e0, e1, x) {
      const t = Math.max(0, Math.min(1, (x-e0)/(e1-e0)))
      return t*t*(3-2*t)
    }

    function mixColor(a, b, t) {
      return [a[0]+(b[0]-a[0])*t, a[1]+(b[1]-a[1])*t, a[2]+(b[2]-a[2])*t]
    }

  // END UPSTREAM SETTINGS, CONSTANTS AND HELPERS
  let particles = [];
  const mouse = { x: 0, y: 0, hovering: false };
  const smoothMouse = { x: 0, y: 0 };
  let time = 0, last = null, frame = 0;
  let failed = false, printing = false, pageActive = true;
  let inViewport = typeof IntersectionObserver !== 'function';
  const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const reduced = () => (!document.body || !document.body.getAttribute || document.body.getAttribute('data-prefers-reduced-motion') !== '0') && motion.matches;
  const visible = () => !view.hidden && !document.hidden && inViewport && !printing && pageActive;

  // BEGIN UPSTREAM PARTICLE INITIALIZATION
    function initParticles() {
      particles = []
      for (let y = 0; y < GRID_Y; y++) {
        for (let x = 0; x < GRID_X; x++) {
          const u = x / (GRID_X - 1)
          const v = y / (GRID_Y - 1)
          let px = (u - 0.5) * GRID_WIDTH
          let py = (v - 0.5) * GRID_HEIGHT
          px += (Math.random() - 0.5) * JITTER
          py += (Math.random() - 0.5) * JITTER
          particles.push({ ox: px, oy: py, random: Math.random() })
        }
      }
    }
  // END UPSTREAM PARTICLE INITIALIZATION

  // BEGIN UPSTREAM DRAWING
  function draw() {
    const t = time;
      const w = canvas.width, h = canvas.height
      const sm = smoothMouse

      const aspect = w / h
      const vH = 2 * 5 * Math.tan((75 / 2) * Math.PI / 180)
      const vW = vH * aspect

      if (mouse.hovering) {
        const baseX = (mouse.x * vW) / 2
        const baseY = (mouse.y * vH) / 2
        const jitterRadius = Math.min(vW, vH) * CURSOR_RADIUS
        const jX = (Math.sin(t*0.35) + Math.sin(t*0.77+1.2)) * 0.5
        const jY = (Math.cos(t*0.31) + Math.sin(t*0.63+2.4)) * 0.5
        const targetX = baseX + jX * jitterRadius * P.cursorStrength
        const targetY = baseY + jY * jitterRadius * P.cursorStrength
        sm.x += (targetX - sm.x) * CURSOR_DRAG
        sm.y += (targetY - sm.y) * CURSOR_DRAG
      }

      const scaleX = w / vW, scaleY = h / vH
      const cx = w * 0.5, cy = h * 0.5

      const breathCycle = Math.sin(t * P.breathSpeed)
      const baseRadius  = P.haloRadius + breathCycle * HALO_RADIUS_AMP

      ctx.clearRect(0, 0, w, h)

      for (let i = 0; i < particles.length; i++) {
        const p = particles[i]

        let posX = p.ox, posY = p.oy
        const driftSpeed = t * 0.15
        const dx = Math.sin(driftSpeed + posY*0.5) + Math.sin(driftSpeed*0.5 + posY*2.0)
        const dy = Math.cos(driftSpeed + posX*0.5) + Math.cos(driftSpeed*0.5 + posX*2.0)
        posX += dx * 0.25
        posY += dy * 0.25

        const relX = posX - sm.x, relY = posY - sm.y
        const scaledRelX = relX / Math.max(HALO_SCALE_X, 0.0001)
        const scaledRelY = relY / Math.max(HALO_SCALE_Y, 0.0001)
        const distFromMouse = Math.sqrt(scaledRelX*scaledRelX + scaledRelY*scaledRelY)
        const dirLen = Math.max(Math.sqrt(relX*relX + relY*relY), 0.0001)
        const dirX = relX / dirLen, dirY = relY / dirLen

        const shapeFactor = noise2d(dirX*2.0, dirY*2.0 + t*0.1)
        const currentRadius = baseRadius + shapeFactor * HALO_SHAPE_AMP
        const rimInfluence = smoothstep(HALO_RIM_WIDTH, 0.0, Math.abs(distFromMouse - currentRadius))

        const pushAmt = (breathCycle*0.5 + 0.5) * 0.5
        posX += dirX * pushAmt * rimInfluence
        posY += dirY * pushAmt * rimInfluence

        const outerInfluence = smoothstep(baseRadius+OUTER_START, baseRadius+OUTER_END, distFromMouse)
        const outerOsc = Math.sin(t*OUTER_OSC_FREQ + posX*0.6 + posY*0.6)
        const outerJitterX = (noise2d(p.ox*4.0 + t*OUTER_OSC_JITTER_SPEED, p.oy*4.0)*2-1) * OUTER_OSC_JITTER_STRENGTH
        const outerJitterY = (noise2d(p.oy*4.0 + t*OUTER_OSC_JITTER_SPEED, p.ox*4.0)*2-1) * OUTER_OSC_JITTER_STRENGTH
        posX += (dirX*outerOsc*OUTER_OSC_AMP + outerJitterX) * outerInfluence
        posY += (dirY*outerOsc*OUTER_OSC_AMP + outerJitterY) * outerInfluence

        const bSize = PARTICLE_BASE_SIZE + Math.sin(t + posX) * 0.003
        const currentScale = bSize + rimInfluence * P.activeSize
        const stretch = rimInfluence * 0.02
        const drawW = (currentScale + stretch) * BLOB_SCALE_X * scaleX
        const drawH = currentScale * BLOB_SCALE_Y * scaleY

        if (drawW < 0.3 && drawH < 0.3) continue

        const oscPhase  = p.random * Math.PI * 2
        const osc       = 0.5 + 0.5 * Math.sin(t*(0.25 + OSC_FACTOR*0.35) + oscPhase)
        const speedScale  = 0.55 + 0.8 * osc
        const jitterScale = 0.7  + 0.75 * osc

        const driftLen = Math.max(Math.sqrt(dx*dx + dy*dy), 0.0001)
        const driftX = dx/driftLen, driftY = dy/driftLen
        const blendX = driftX + (dirX - driftX) * P.cursorFollow
        const blendY = driftY + (dirY - driftY) * P.cursorFollow
        const blendLen = Math.max(Math.sqrt(blendX*blendX + blendY*blendY), 0.0001)
        const bDirX = blendX/blendLen, bDirY = blendY/blendLen

        const rotJitter = Math.sin(t*ROTATION_SPEED*speedScale + posX*0.35 + posY*0.35) * (ROTATION_JITTER*jitterScale)
        const perpX = -bDirY, perpY = bDirX
        const jDirX = bDirX + perpX*rotJitter
        const jDirY = bDirY + perpY*rotJitter
        const jDirLen = Math.max(Math.sqrt(jDirX*jDirX + jDirY*jDirY), 0.0001)
        const angle = Math.atan2(jDirY/jDirLen, jDirX/jDirLen)

        const p1 = Math.sin(posX*0.8 + t*1.2)
        const p2 = Math.sin(posY*0.8 + t*1.2*0.8 + p1)
        let activeColor = mixColor(COLOR_ONE, COLOR_TWO, p1*0.5+0.5)
        activeColor = mixColor(activeColor, COLOR_THREE, p2*0.5+0.5)
        const colorMix  = smoothstep(0.1, 0.8, rimInfluence)
        const finalColor = mixColor(COLOR_BASE, activeColor, colorMix)
        const finalAlpha = 0.4 + 0.55 * rimInfluence

        const screenX = cx + posX * scaleX
        const screenY = cy - posY * scaleY

        ctx.save()
        ctx.translate(screenX, screenY)
        ctx.rotate(-angle)
        ctx.globalAlpha = finalAlpha

        const r = Math.round(finalColor[0])
        const g = Math.round(finalColor[1])
        const b = Math.round(finalColor[2])
        const grad = ctx.createRadialGradient(0,0,0, 0,0, Math.max(drawW, drawH))
        grad.addColorStop(0,   `rgba(${r},${g},${b},1)`)
        grad.addColorStop(0.7, `rgba(${r},${g},${b},0.8)`)
        grad.addColorStop(1,   `rgba(${r},${g},${b},0)`)
        ctx.fillStyle = grad

        ctx.beginPath()
        ctx.ellipse(0, 0, drawW, drawH, 0, 0, Math.PI*2)
        ctx.fill()
        ctx.restore()
      }

      ctx.globalAlpha = 1
  }

  // END UPSTREAM DRAWING

  function stop() {
    if (frame) cancelAnimationFrame(frame);
    frame = 0; last = null;
  }
  function fail() {
    failed = true; canvas.hidden = true; stop();
  }
  function resize() {
    const box = host.getBoundingClientRect();
    if (box.width <= 0 || box.height <= 0) return false;
    const dpr = window.devicePixelRatio || 1;
    const w = Math.max(1, Math.round(box.width * dpr));
    const h = Math.max(1, Math.round(box.height * dpr));
    if (canvas.width !== w || canvas.height !== h) {
      canvas.width = w; canvas.height = h;
    }
    return true;
  }
  function syncTheme() {
    const theme = document.documentElement.dataset
      ? document.documentElement.dataset.theme
      : document.documentElement.getAttribute('data-theme');
    const isLight = theme === 'light';
    COLOR_BASE[0] = isLight ? 200 : 0;
    COLOR_BASE[1] = isLight ? 200 : 0;
    COLOR_BASE[2] = isLight ? 220 : 255;
  }
  function paint() {
    try { draw(); canvas.hidden = false; return true; }
    catch (_) { fail(); return false; }
  }
  function tick(now) {
    frame = 0;
    if (!visible() || failed || reduced()) { last = null; return; }
    // Keep the upstream 0.05s timestep ceiling and per-frame cursor drag.
    const dt = last === null ? 0 : Math.min(Math.max(0, (now - last) / 1000), 0.05);
    last = now; time += dt;
    if (paint()) frame = requestAnimationFrame(tick);
  }
  function sync() {
    host.hidden = view.hidden;
    stop();
    if (failed || !visible()) { mouse.hovering = false; return; }
    try {
      if (!resize()) return;
      syncTheme();
      if (reduced()) mouse.hovering = false;
      if (paint() && !reduced()) frame = requestAnimationFrame(tick);
    } catch (_) { fail(); }
  }
  document.addEventListener('pointermove', event => {
    if (!visible() || reduced()) return;
    const box = host.getBoundingClientRect();
    if (box.width <= 0 || box.height <= 0) return;
    mouse.x = ((event.clientX - box.left) / box.width) * 2 - 1;
    mouse.y = -(((event.clientY - box.top) / box.height) * 2 - 1);
    mouse.hovering = true;
  }, { passive: true });
  const release = () => { mouse.hovering = false; };
  document.addEventListener('pointerleave', release, { passive: true });
  document.addEventListener('pointercancel', release, { passive: true });
  window.addEventListener('blur', release);
  const observer = new MutationObserver(sync);
  observer.observe(view, { attributes: true, attributeFilter: ['hidden'] });
  observer.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
  if (document.body) observer.observe(document.body, { attributes: true, attributeFilter: ['data-prefers-reduced-motion'] });
  if (typeof IntersectionObserver === 'function') {
    const intersection = new IntersectionObserver(entries => {
      inViewport = entries.some(entry => entry.isIntersecting); sync();
    });
    intersection.observe(view);
  }
  if (typeof ResizeObserver === 'function') {
    const resizeObserver = new ResizeObserver(sync); resizeObserver.observe(host);
  }
  if (motion.addEventListener) motion.addEventListener('change', sync);
  else motion.addListener(sync);
  window.addEventListener('resize', sync);
  document.addEventListener('visibilitychange', sync);
  window.addEventListener('pagehide', () => { pageActive = false; release(); stop(); });
  window.addEventListener('pageshow', () => { pageActive = true; sync(); });
  window.addEventListener('beforeprint', () => { printing = true; stop(); });
  window.addEventListener('afterprint', () => { printing = false; sync(); });

  // Upstream density control did this before rebuilding its grid.
  GRID_X = Math.max(2, Math.round(GRID_X_BASE * P.density));
  GRID_Y = Math.max(2, Math.round(GRID_Y_BASE * P.density));
  initParticles();
  sync();
})();
  //]]></script>
  {% } else if (bgUrl) { %}
  <!-- Image Background Start -->
  <div class="main-bg" id="main-bg" style="background-image:url({{ bgUrl }})"></div>
  <!-- Image Background End -->
  {% } %}
  <!-- Login Container Start -->
  <div class="login-container">
    <div class="login-form">
      <!-- Card Header Start -->
      <div class="ms-card-header">
        <button type="button" class="ms-back-button" id="ms-back-btn" style="display: none;" aria-label="Back">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="17" y1="12" x2="7" y2="12"></line>
            <polyline points="11 17 6 12 11 7"></polyline>
          </svg>
        </button>
        <a class="brand" href="/">
          <img src="{{ media }}/img/fluent.svg" class="icon" alt="" />
          <span class="brand-text">{{ hostname }}</span>
        </a>
      </div>
      <!-- Card Header End -->

      <!-- Login Form Start -->
      <form class="form-login" method="post" action="">
        <!-- Step 1: Username -->
        <div id="step-username" class="step-container">
          <h2 class="login-title">{{ _('Authorization Required') }}</h2>
          <p class="login-subtitle">{{ _('Please enter your username.') }}</p>

          <div class="input-container">
            <div class="ms-input-wrapper">
              <input class="ms-input{% if (fuser) { %} cbi-input-invalid{% } %}" id="cbi-input-user" type="text" name="luci_username" autocomplete="username" value="{{ entityencode(duser, true) }}" placeholder=" " />
              <label class="ms-label" for="cbi-input-user">{{ _('Username') }}</label>
              <div class="ms-input-underline"></div>
            </div>
          </div>

          <div class="button-container">
            <button type="button" class="ms-button" id="btn-next">{{ _('Next') }}</button>
          </div>
        </div>

        <!-- Step 2: Password -->
        <div id="step-password" class="step-container">
          <div class="login-account-pill-wrapper">
            <div class="login-account-pill" id="login-account-pill">
              <span class="login-account-pill__text" id="login-account-pill-text"></span>
            </div>
          </div>

          <h2 class="login-title">{{ _('Authorization Required') }}</h2>
          <p class="login-subtitle">{{ _('Please enter your password.') }}</p>

          <div class="input-container">
            <div class="ms-input-wrapper password-wrapper">
              <input class="ms-input{% if (fuser) { %} cbi-input-invalid{% } %}" id="cbi-input-password" type="password" name="luci_password" autocomplete="current-password" placeholder=" " />
              <label class="ms-label" for="cbi-input-password">{{ _('Password') }}</label>
              <button type="button" class="ms-password-toggle" id="ms-password-toggle" aria-pressed="false" aria-label="Toggle password visibility">
                <svg class="eye-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                  <circle cx="12" cy="12" r="3"></circle>
                </svg>
              </button>
              <div class="ms-input-underline"></div>
            </div>
            {%- if (fuser) { %}
            <div class="errorbox" role="alert">{{ _('Invalid username and/or password! Please try again.') }}</div>
            {%- } %}
          </div>

          <div class="button-container">
            <input type="submit" value="{{ _('Login') }}" class="ms-button" id="btn-login" />
          </div>
        </div>
      </form>
      <!-- Login Form End -->
      <script type="text/javascript">//<![CDATA[
        (function() {
          var userInput = document.getElementById('cbi-input-user');
          var passInput = document.getElementById('cbi-input-password');
          var backBtn = document.getElementById('ms-back-btn');
          var btnNext = document.getElementById('btn-next');
          var accountPillText = document.getElementById('login-account-pill-text');
          var passwordToggle = document.getElementById('ms-password-toggle');
          var errorBox = document.querySelector('.errorbox');
          var loginFormEl = document.querySelector('.form-login');

          function getCurrentHost() {
            if (window.location && window.location.host) {
              return window.location.host;
            }

            return '{{ entityencode(hostname, true) }}';
          }

          function formatAccountPill(username) {
            var normalizedUsername = username ? username.trim() : '';

            if (!normalizedUsername) {
              return '';
            }

            var currentHost = getCurrentHost();

            return currentHost ? normalizedUsername + '@' + currentHost : normalizedUsername;
          }

          function syncAccountPill() {
            if (accountPillText && userInput) {
              accountPillText.textContent = formatAccountPill(userInput.value);
            }
          }
          function clearError() {
            if (errorBox) errorBox.style.display = 'none';
            if (userInput) userInput.classList.remove('cbi-input-invalid');
            if (passInput) passInput.classList.remove('cbi-input-invalid');
          }

          if (userInput) {
            userInput.addEventListener('input', clearError);
          }
          if (passInput) {
            passInput.addEventListener('input', clearError);
          }

          function showStep2() {
            if (loginFormEl) loginFormEl.classList.add('show-step2');
            if (backBtn) backBtn.style.display = 'flex';
            if (passInput) {
              setTimeout(function() {
                passInput.focus();
              }, 50);
            }
          }

          function showStep1() {
            if (loginFormEl) loginFormEl.classList.remove('show-step2');
            if (backBtn) backBtn.style.display = 'none';
            if (userInput) {
              setTimeout(function() {
                userInput.focus();
              }, 50);
            }
          }

          if (btnNext && userInput) {
            btnNext.addEventListener('click', function(e) {
              e.preventDefault();
              if (userInput.value.trim() !== '') {
                syncAccountPill();
                showStep2();
              } else {
                if (typeof userInput.reportValidity === 'function') {
                  userInput.reportValidity();
                } else {
                  alert('{{ _('Username is required.') }}');
                }
              }
            });

            userInput.addEventListener('keydown', function(e) {
              if (e.key === 'Enter') {
                e.preventDefault();
                btnNext.click();
              }
            });
          }

          if (backBtn) {
            backBtn.addEventListener('click', function(e) {
              e.preventDefault();
              showStep1();
            });
          }

          if (passwordToggle && passInput) {
            passwordToggle.addEventListener('click', function(e) {
              e.preventDefault();
              if (passInput.type === 'password') {
                passInput.type = 'text';
                passwordToggle.setAttribute('aria-pressed', 'true');
                passwordToggle.innerHTML = '<svg class="eye-off-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line></svg>';
              } else {
                passInput.type = 'password';
                passwordToggle.setAttribute('aria-pressed', 'false');
                passwordToggle.innerHTML = '<svg class="eye-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>';
              }
            });
          }

          // Initial router: If username is already populated, go straight to Step 2.
          if (userInput && userInput.value.trim() !== '') {
              syncAccountPill();
            if (loginFormEl) {
              loginFormEl.classList.add('no-transition');
              showStep2();
              // Force reflow to flush styles before removing no-transition
              void loginFormEl.offsetHeight;
              loginFormEl.classList.remove('no-transition');
            } else {
              showStep2();
            }
          } else {
            showStep1();
          }
        })();
      //]]></script>
      {%
        let https_key = cfg.get('uhttpd', 'main', 'key');
        let https_port = cfg.get('uhttpd', 'main', 'listen_https');

        if (type(https_port) === 'object') {
          https_port = https_port[0];
        }

        if (https_port && access(https_key)) {
          let m = match(https_port, regexp('(\\d+)$'));
          https_port = m ? m[1] : null;
      %}
      <script type="text/javascript">//<![CDATA[
        if (document.location.protocol != 'https:') {
          var url = 'https://' + window.location.hostname + ':' + '{{ https_port }}' + window.location.pathname;
          var img = new Image;
          img.onload = function () { window.location = url };
          img.src = 'https://' + window.location.hostname + ':' + '{{ https_port }}' + '{{ resource }}/cbi/up.gif?' + Math.random();
          setTimeout(function () {
            img.src = ''
          }, 5000);
        }
      //]]></script>
      {% } %}
{% include('themes/fluent/footer_login'); %}
<!-- Login Page End -->
