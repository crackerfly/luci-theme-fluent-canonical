run_pnpm() {
  if command -v pnpm >/dev/null 2>&1; then
    pnpm "$@"
  elif command -v corepack >/dev/null 2>&1; then
    corepack pnpm "$@"
  else
    echo "Error: neither pnpm nor corepack was found in PATH." >&2
    exit 127
  fi
}

case "$(uname -s 2>/dev/null)" in
  MINGW*|MSYS*|CYGWIN*)
    if command -v pwsh >/dev/null 2>&1; then
      # PowerShell preserves native PATH entries for Node child processes on Windows.
      pwsh -NoProfile -Command '$env:Path = [Environment]::GetEnvironmentVariable("Path", "Machine") + ";" + [Environment]::GetEnvironmentVariable("Path", "User"); pnpm exec lint-staged; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }; pnpm run typecheck'
      exit $?
    fi
    ;;
esac

run_pnpm exec lint-staged
run_pnpm run typecheck
